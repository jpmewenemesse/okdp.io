---
import ProvenanceBadge from "@/components/stack/ProvenanceBadge.astro";
import type { HomeTranslations } from "@/i18n/translations";
import type { ChartRef, LocalizedComponent } from "@/types/stack";

interface Props {
  component: LocalizedComponent;
  content: HomeTranslations;
}

const { component, content } = Astro.props;
const copy = content.stackPage;

const packageRef = `${component.package.repository}:${component.package.tag}`;
const chart = component.primaryChart;
const notice = component.notice
  ? copy.notices[component.notice.key as keyof typeof copy.notices]
  : null;
// Every reference the package pulls in, flat and deduplicated. The module a
// reference belongs to is structure, not identity, and the package definition
// carries it authoritatively.
//
// A chart published to a registry is a complete reference on its own. One served
// from a Helm repository is not, so the repository follows it: the reference and
// its website, nothing else. Local charts are vendored in the package repo and
// have no reference at all.
const chartRef = (entry: ChartRef) =>
  entry.repository!.startsWith("http")
    ? `${entry.name}:${entry.version} (${entry.repository})`
    : `${entry.repository}:${entry.version}`;

const references = [
  ...new Set([
    ...component.charts
      .filter((entry) => entry.version && entry.repository)
      .map(chartRef),
    ...component.images.map((image) => `${image.repository}:${image.tag}`),
  ]),
];

// Everything a filter should match, lowercased once at build time.
const haystack = [
  component.name,
  component.id,
  component.upstreamVersion,
  component.package.tag,
  chart?.name,
  component.description,
]
  .filter(Boolean)
  .join(" ")
  .toLowerCase();
---

<details
  class="group border-accent border-b"
  data-component
  data-section={component.section}
  data-search={haystack}
>
  <summary
    class="hover:bg-background-alt grid cursor-pointer list-none grid-cols-2 items-center gap-x-4 gap-y-1 px-4 py-3 transition-colors md:grid-cols-[minmax(0,2.2fr)_minmax(0,1fr)_minmax(0,1.4fr)_minmax(0,1.5fr)_minmax(0,1.3fr)]"
  >
    <div class="flex min-w-0 items-center gap-2.5">
      <span
        class="text-text-light shrink-0 text-[10px] transition-transform group-open:rotate-90"
        aria-hidden="true">▶</span
      >
      <span class="truncate text-sm font-semibold">{component.name}</span>
    </div>

    <div class="text-right md:text-left">
      <span class="font-mono text-sm font-semibold break-all"
        >{component.upstreamVersion}</span
      >
    </div>

    <div class="col-span-2 md:col-span-1">
      <code class="text-text-light font-mono text-xs break-all"
        >{component.package.tag}</code
      >
    </div>

    <div class="col-span-2 flex flex-wrap gap-1 md:col-span-1">
      {
        component.provenance.map((provenance) => (
          <ProvenanceBadge provenance={provenance} content={content} />
        ))
      }
    </div>

    <div
      class="text-text-light col-span-2 truncate font-mono text-xs md:col-span-1"
    >
      {chart ? `${chart.name} ${chart.version ?? ""}`.trim() : ""}
    </div>
  </summary>

  <div class="bg-background-alt border-accent border-t px-4 py-4 md:ps-11">
    {
      notice && (
        <div class="mb-4 max-w-3xl rounded border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-900">
          {notice.text}
        </div>
      )
    }
    {
      component.description && (
        <p class="text-text-light mb-4 max-w-3xl text-sm">
          {component.description}
        </p>
      )
    }

    <div class="mb-4 flex flex-wrap items-center gap-2">
      <code
        class="border-accent bg-background rounded border px-2 py-1 font-mono text-xs break-all"
        >{packageRef}</code
      >
      <button
        type="button"
        class="border-accent hover:border-primary hover:text-primary rounded border px-2 py-1 text-xs transition-colors"
        data-copy={packageRef}
        data-copy-label={copy.copy.label}
        data-copy-done={copy.copy.done}
      >
        {copy.copy.label}
      </button>
    </div>

    {
      references.length > 0 && (
        <div class="mb-4">
          <h4 class="text-text-light mb-2 text-xs font-semibold tracking-wide uppercase">
            {copy.details.references}
          </h4>
          <ul class="space-y-1">
            {references.map((ref) => (
              <li class="text-text-light font-mono text-xs break-all">{ref}</li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="flex flex-wrap gap-x-5 gap-y-1 text-xs">
      {
        component.links.upstream && (
          <a
            href={component.links.upstream}
            class="text-primary hover:underline"
            rel="noopener noreferrer"
            target="_blank"
          >
            {copy.details.upstream} ↗
          </a>
        )
      }
      <a
        href={component.links.source}
        class="text-primary hover:underline"
        rel="noopener noreferrer"
        target="_blank"
      >
        {copy.details.source} ↗
      </a>
    </div>
  </div>
</details>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
